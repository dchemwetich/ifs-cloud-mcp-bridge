# Legacy single-environment setup. Prefer add_ifs_environment, which stores
# environments in ~/.ifs-mcp/config.json. These variables override it when set.

# IFS Cloud Configuration
API_BASE_URL=https://your-instance.ifs.cloud
OAUTH_REALM=your-realm-name

# OAuth 2.0 Public Client (no client secret required)
OAUTH_CLIENT_ID=your-client-id

# Optional: path to a separate skills directory (e.g. a cloned skills repository)
# If set, skills are read from and written to this directory instead of src/ifs_mcp/resources/
# SKILLS_DIR=/path/to/your/ifs-skills-repo

# Optional: folder for CSV exports from export_api_data (default: ~/Downloads, else ~/.ifs-mcp/exports)
# EXPORT_DIR=/path/to/exports
